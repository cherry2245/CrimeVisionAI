# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Server
HOST=127.0.0.1
PORT=5000

# Database
DATABASE_URL=sqlite:///crimevision.db

# Storage Paths
UPLOAD_FOLDER=storage/uploads
EVIDENCE_FOLDER=storage/evidence
REPORTS_FOLDER=storage/reports
THUMBNAILS_FOLDER=storage/thumbnails
MAX_UPLOAD_SIZE=524288000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq API (Optional - leave empty if not configured)
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# Object Detection
DETECTION_MODEL=facebook/detr-resnet-50
DETECTION_CONFIDENCE_THRESHOLD=0.5

# Audio Transcription
WHISPER_MODEL=base
WHISPER_DEVICE=auto

# Image Captioning
CAPTIONING_MODEL=Salesforce/blip-image-captioning-base

# Video Processing
VIDEO_FRAME_SAMPLE_INTERVAL=30
MAX_VIDEO_DURATION=3600

# Job Processing
MAX_CONCURRENT_JOBS=2
